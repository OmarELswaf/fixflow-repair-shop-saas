{
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.0",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/platform-express": "12.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/express": "^5.0.6",
    "argon2": "0.45.2",
    "bullmq": "6.7.8",
    "decimal.js": "10.6.0",
    "dotenv": "17.2.3",
    "express": "^5.3.0",
    "ioredis": "6.1.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@electric-sql/pglite-socket": "0.3.0",
    "@nestjs/cli": "12.0.15",
    "@nestjs/testing": "12.6.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.0",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageDirectory": "./coverage",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    }
  },
  "name": "@fixflow/api",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "start": "node dist/main.js",
    "test": "jest",
    "test:e2e": "npm run build && node ../../scripts/test-auth-http.mjs",
    "typecheck": "tsc --noEmit"
  },
  "version": "0.1.0"
}
