# FixFlow Phase 2 — .env.example — PLACEHOLDERS ONLY. No real secrets.
# Copy to .env for local development. Never commit a real .env.
NODE_ENV=development
PORT=3000
WEB_PORT=5173

# PostgreSQL — app role is a NON-OWNER role, no BYPASSRLS. See docker/postgres/01-app-role.sh.
# The app role password is set via APP_DB_PASSWORD (used by the init script
# and by DATABASE_URL). The owner password is POSTGRES_PASSWORD.
POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://fixflow_app:CHANGE_ME@localhost:5432/fixflow?schema=public
# Owner/migration URL, used only by migrate-and-start.sh for `prisma migrate deploy`.
MIGRATION_DATABASE_URL=postgresql://fixflow_owner:CHANGE_ME@localhost:5432/fixflow?schema=public

REDIS_URL=redis://localhost:6379

# JWT — short-lived access, rotating refresh. Replace in every environment.
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

# Browser origins allowed to use the ff_refresh cookie (comma-separated).
# Used by the CSRF/Origin check on cookie-authenticated auth mutations.
WEB_ORIGINS=http://localhost:5173

# Demo seed — local only. Seed reads this at runtime; it is not a credential in the repo.
DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD

# Integrations — ALL explicitly UNCONFIGURED / disabled by default in Phase 2.
WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=CHANGE_ME
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=CHANGE_ME
EMAIL_SMTP_USER=CHANGE_ME
EMAIL_SMTP_PASSWORD=CHANGE_ME
AI_ENABLED=false
AI_PROVIDER=CHANGE_ME
AI_API_KEY=CHANGE_ME
PAYMENT_PROVIDER_ENABLED=false
PAYMENT_PROVIDER_API_KEY=CHANGE_ME
PAYMENT_WEBHOOK_SECRET=CHANGE_ME
